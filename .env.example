# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# App
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# Telegram
BOT_TOKEN_ENCRYPTION_KEY=your-32-byte-hex-key

# Cron
CRON_SECRET=your-cron-secret

# Groq (server-side only — never NEXT_PUBLIC_). The code reads GROQ_API_KEY.
GROQ_API_KEY=your-groq-api-key

# Hindsight by Vectorize (server-side only — never NEXT_PUBLIC_)
HINDSIGHT_API_KEY=hsk_your-hindsight-api-key
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
HINDSIGHT_ENABLED=true
HINDSIGHT_BANK_PREFIX=btc-prod
# BEP20 verification. Public BSC JSON-RPC is used when BSC_RPC_URLS is unset.
# Set BSC_RPC_URLS to an empty value to disable those defaults. Never commit a private RPC URL.
BSC_RPC_URLS=
# Optional. Defaults to 15. Range 1 to 10000.
BEP20_MIN_CONFIRMATIONS=15
# Optional second source. Used only when set. Etherscan API V2, chain id 56.
ETHERSCAN_API_KEY=
# Local demo payments only. Ignored when NODE_ENV is production.
PAYMENT_SANDBOX=
# Unused. Live checks no longer call BscScan V1.
BSCSCAN_API_KEY=
ACTIVE_SUPPLIER=
SUPPLIER_1_API_KEY=
SUPPLIER_1_BASE_URL=
