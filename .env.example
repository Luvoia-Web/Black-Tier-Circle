# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Encryption key for bot tokens and payment secrets stored in the database.
# Generate once: openssl rand -hex 32
BOT_TOKEN_ENCRYPTION_KEY=

# BscScan key for live BEP20 verification. PLACEHOLDER_ keeps chain checks in demo mode.
BSC_RPC_URL=
BSCSCAN_API_KEY=PLACEHOLDER_BSCSCAN_KEY

# Internal
ADMIN_SECRET=
CRON_SECRET=
NEXT_PUBLIC_APP_URL=

# Supplier connector — PLACEHOLDER_ values keep sandbox mode.
ACTIVE_SUPPLIER=
SUPPLIER_1_API_KEY=
SUPPLIER_1_BASE_URL=

# Bots, Binance Pay, and USDT wallets are configured in the owner dashboard
# after deploy. Do not put those secrets in environment variables.
